# Placeholder values only. Copy to .env for Docker; never commit the resulting file.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://openhub_app:REPLACE_WITH_DIFFERENT_RANDOM_VALUE@127.0.0.1:54329/openhubpanel
MIGRATION_DATABASE_URL=postgresql://openhub_admin:REPLACE_WITH_RANDOM_VALUE@127.0.0.1:54329/openhubpanel
REDIS_URL=redis://:REPLACE_WITH_RANDOM_VALUE@127.0.0.1:63799
REDIS_PASSWORD=REPLACE_WITH_RANDOM_VALUE
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
APP_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
# Generate these with pnpm setup:local; never paste real secrets into this example.
ENCRYPTION_KEY=
READINESS_TOKEN=

# Optional separate general product. Provision all values privately before enabling.
GENERAL_ENABLED=0
GENERAL_DATABASE_URL=
GENERAL_ENCRYPTION_KEY=
# Migration operator only; do not expose this connection to the web process.
GENERAL_MIGRATION_DATABASE_URL=
# Enable only behind a private backend and a proxy that overwrites the client-IP header.
GENERAL_TRUST_PROXY=0
